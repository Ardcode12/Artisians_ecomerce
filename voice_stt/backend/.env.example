# AI4Bharat STT Module Environment Configuration
# Copy this file to .env and edit as needed

# Device: auto | cpu | cuda
DEVICE=auto

# Model to use: indic_whisper (default)
STT_BACKEND=indic_whisper

# ── Model Selection ────────────────────────────────────────────────────────────
#
# OPTION 1 (Recommended for CPU): openai/whisper-large-v3
#   Single multilingual model supporting ALL Indian languages.
#   ~3 GB download. Solid accuracy for Tamil, Telugu, Hindi.
#   Use this if you want one model for all languages on CPU.
#
INDICWHISPER_MODEL_ID=openai/whisper-large-v3
#
# OPTION 2 (Best accuracy, one model per language — needs more RAM/VRAM):
#   Per-language fine-tunes on AI4Bharat Vistaar dataset by vasista22.
#   Each model is ~3 GB. Load one at a time.
#   Tamil  : vasista22/whisper-tamil-large-v2
#   Telugu : vasista22/whisper-telugu-large-v2
#   Hindi  : vasista22/whisper-hindi-large-v2
#   Medium (lighter, faster on CPU):
#   Tamil  : vasista22/whisper-tamil-medium
#   Telugu : vasista22/whisper-telugu-medium
#   Hindi  : vasista22/whisper-hindi-medium
#
# Uncomment one to override:
# INDICWHISPER_MODEL_ID=vasista22/whisper-tamil-large-v2
# ──────────────────────────────────────────────────────────────────────────────

# Cache directory for downloaded model weights (relative to backend/)
HF_CACHE_DIR=.cache/huggingface

# FastAPI server settings
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
