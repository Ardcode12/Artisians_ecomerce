# Local PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_postgres_password_here@127.0.0.1:5432/artisans

# Server Port
PORT=5000
HOST=0.0.0.0

# ── Ollama (text/AI generation) ─────────────────────────────────────────────
# Remote A100 GPU served by Ollama — used for product description generation.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_USERNAME=ollama
OLLAMA_PASSWORD=your_ollama_password_here

# ── Remote Whisper STT (NVIDIA A100 — Whisper Large V3) ─────────────────────
# Audio is forwarded from this backend to the remote A100 server over HTTPS.
# Credentials are used for HTTP Basic Authentication.
# WHISPER_PASSWORD must NEVER be hardcoded — set it only in .env (not tracked by Git).
WHISPER_BASE_URL=https://tapping-backward-sprite.ngrok-free.dev/whisper
WHISPER_USERNAME=ollama
WHISPER_PASSWORD=your_whisper_password_here
WHISPER_MODEL=whisper-large-v3

# ── Optional AI fallbacks ────────────────────────────────────────────────────
# Used for multilingual description generation if Ollama is unavailable.
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Sarvam AI TTS ────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3

# ── Cloudinary (image hosting) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── App ──────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:5000
